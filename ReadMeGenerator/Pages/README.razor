## My top projects

@foreach (var repo in Data.TopRepos)
{
    @((MarkupString)$"**[{repo.Name}]({repo.Url})**<br>\n")
    @((MarkupString)$"{EscapeMd(repo.Description)}<br>\n")
    @if (repo.NuGetBadges.Count > 0)
    {
        @((MarkupString)$"⭐ {repo.Stars} &emsp; 🍴 {repo.Forks}  <br>\n")
        @((MarkupString)$"{string.Join(" ", repo.NuGetBadges.Select(b => b.BadgeMarkdown))}\n\n")
    }
    else
    {
        @((MarkupString)$"⭐ {repo.Stars} &emsp; 🍴 {repo.Forks}\n\n")
    }
}

@code {
    private static string EscapeMd(string text) => text
        .Replace("&", "&amp;")
        .Replace("<", "&lt;")
        .Replace(">", "&gt;");
}
